@model StudentEnrollmentAndPayment.Database.AppDbContextModels.TblPersonalInformation

<h2>Edit Student</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="StudentId" />

    <div class="form-group">
        <label>Roll No.</label>
        <input asp-for="RollNo" class="form-control" />
    </div>

    <div class="form-group">
        <label>Full Name</label>
        <input asp-for="FullName" class="form-control" />
    </div>

    <div class="form-group">
        <label>NRC</label>
        <input asp-for="Nrc" class="form-control" />
    </div>

    <div class="form-group">
        <label>Phone</label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <!-- Current Image -->
    <div>
        <label>Current Profile</label><br />
        @if (!string.IsNullOrEmpty(Model.Profile))
        {
            <img src="@Model.Profile" width="80" />
        }
    </div>

    <!-- Upload New -->
    <div class="form-group">
        <label>Change Profile</label>
        <input type="file" name="ProfileFile" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>