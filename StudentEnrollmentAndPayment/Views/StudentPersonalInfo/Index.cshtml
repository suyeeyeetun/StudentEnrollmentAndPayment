@model IEnumerable<StudentEnrollmentAndPayment.Database.AppDbContextModels.TblPersonalInformation>

<h2>Student List</h2>
<h5>Total Enrollments - @Model.Count()</h5>
<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-primary">Add New</a>
    <form method="get" asp-action="Index">

        <select name="majorId" class="form-control" style="width:200px; display:inline-block;">
            <option value="">-- Select Major --</option>

            @foreach (var m in ViewBag.Majors)
            {
                <option value="@m.MajorId"
                        selected="@(ViewBag.SelectedMajor == m.MajorId)">
                    @m.MajorName
                </option>
            }
        </select>

        <select name="yearId" class="form-control" style="width:200px; display:inline-block;">
            <option value="">-- Select Year --</option>

            @foreach (var y in ViewBag.Years)
            {
                <option value="@y.AcademicYearId"
                        selected="@(ViewBag.SelectedYear == y.AcademicYearId)">
                    @y.AcademicYear
                </option>
            }
        </select>

        <button type="submit" class="btn btn-primary">Filter</button>

    </form>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Roll No.</th>
            <th>Profile</th>
            <th>Name</th>
            <th>NRC</th>
            <th>Phone</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RollNo</td>
                <!-- PROFILE COLUMN -->
                <td>
                    <div class="text-center align-middle">
                        @if (!string.IsNullOrEmpty(item.Profile))
                        {
                            <img src="@item.Profile"
                                 width="65"
                                 height="65"
                                 style="border-radius:50%; object-fit:cover;" />
                        }
                    </div>
                </td>

                <!-- OTHER COLUMNS -->
                <td>@item.FullName</td>

                <td>@item.Nrc</td>

                <td>@item.PhoneNumber</td>

                <!-- ACTION COLUMN -->
                <td style="width:120px;">

                    <div style="display:flex; gap:10px;">

                        <!-- EDIT -->
                        <a asp-action="Edit"
                           asp-route-id="@item.StudentId"
                           class="btn btn-primary btn-sm"
                           style="width:35px; height:35px; display:flex; align-items:center; justify-content:center;">

                            <i class="fa fa-edit"></i>
                        </a>

                        <!-- DELETE -->
                        <form asp-action="Delete" asp-route-id="@item.StudentId" method="post" style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this student?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fa fa-trash"></i>
                            </button>

                        </form>

                    </div>

                </td>

            </tr>
        }

    </tbody>
</table>